<controls:UserControl
	x:Class="Olympia_ThiSinh.FinishUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Olympia_ThiSinh" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	TextElement.FontWeight="Regular"
	TextElement.FontSize="13"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="Auto"
	FontFamily="{DynamicResource MaterialDesignFont}" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="205" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<TextBlock
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontSize="45"
				FontWeight="Bold"
				Foreground="#FFFFFFFF"
				Text="Phần thi: Về Đích"
				Margin="30" />
			<TextBlock
				Name="txtPackageQuestion"
				TextAlignment="Center"
				Width="370"
				FontWeight="Bold"
				FontSize="25"
				Foreground="#FFFFFFFF"
				FontStyle="Italic"
				VerticalAlignment="Bottom"
				HorizontalAlignment="Right"
				Margin="10" />
		</Grid>
		<Border
			Grid.Row="1"
			BorderBrush="#FFFFFFFF"
			BorderThickness="2"
			CornerRadius="0 0 3 3 "
			Margin="5">
			<Border.Background>
				<SolidColorBrush
					Color="Black"
					Opacity="0.3" />
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="370" />
				</Grid.ColumnDefinitions>
				<GridSplitter
					Grid.Column="1"
					Width="5"
					HorizontalAlignment="Stretch"
					Background="#FFFFFFFF" />
				<Grid
					Column="0">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition
							Height="2.5*" />
						<RowDefinition
							Height="auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition
							Width="7.5*" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid
						Margin="0 0 0 5"
						Row="0"
						Column="1">
						<Panel.Background>
							<ImageBrush
								ImageSource="Images/backgroundv3.png"
								Stretch="Fill" />
						</Panel.Background>
						<ScrollViewer
							Margin=" 0 0 -17 0">
							<TextBlock
								Name="txtQuestion"
								TextWrapping="Wrap"
								Foreground="#FFFFFFFF"
								Margin="10 5 22 5"
								FontSize="28" />
						</ScrollViewer>
					</Grid>
					<Grid
						Row="1"
						Column="1">
						<Panel.Background>
							<ImageBrush
								ImageSource="Images/backgroundv2.png"
								Stretch="Fill" />
						</Panel.Background>
						<Image
							Name="ImageQuestion" />
						<MediaElement
							Name="SoundQuestion"
							UnloadedBehavior="Stop"
							LoadedBehavior="Manual"
							Unloaded="SoundQuestion_Unloaded" />
						<MediaElement
							Name="VideoQuestion"
							UnloadedBehavior="Stop"
							LoadedBehavior="Manual"
							Unloaded="VideoQuestion_Unloaded" />
						<Image
							Name="HopeStarImage"
							Visibility="Collapsed"
							Stretch="Uniform" />
					</Grid>
					<Slider
						Name="countdownSlider"
						Foreground="#FFFF0000"
						Margin="0 -5 0 -5"
						Grid.Row="2"
						Grid.Column="1"
						Minimum="0" />
				</Grid>
				<Grid
					Column="2">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid
						Row="0">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition
								Height="3*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition
								Width="4*" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Grid
							Row="1"
							Column="1">
							<Panel.Background>
								<ImageBrush
									ImageSource="Images/background2.png"
									Stretch="Fill" />
							</Panel.Background>
							<TextBlock
								Name="txtScore"
								Text="0"
								Foreground="#FFFFFFFF"
								FontSize="90"
								TextAlignment="Center"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontWeight="Bold" />
						</Grid>
						<Grid
							Row="0"
							Column="1"
							Margin="0 30 0 -30">
							<Panel.Background>
								<ImageBrush
									ImageSource="Images/typeQuestions.png"
									Stretch="Fill" />
							</Panel.Background>
							<TextBlock
								Name="txtCurrentScorePackage"
								Foreground="#FFFFFFFF"
								FontSize="30"
								TextAlignment="Center"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontWeight="Bold" />
						</Grid>
					</Grid>
					<Grid
						Row="1" />
					<Grid
						Row="2">
						<Button
							Name="btnClaim"
							IsEnabled="False"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Width="200"
							Height="100"
							Click="btnClaim_Click">
							<StackPanel>
								<TextBlock
									Foreground="#FFFFFFFF"
									FontSize="30"
									Text="Giành quyền" />
							</StackPanel>
						</Button>
					</Grid>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</controls:UserControl>
