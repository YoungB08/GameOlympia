<windows:Window
	x:Class="Olympia_ThiSinh.ChoosePackageQuestion" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Olympia_ThiSinh" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	Style="{StaticResource MaterialDesignWindow}"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	TextElement.FontWeight="Regular"
	TextElement.FontSize="13"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="Auto"
	FontFamily="{DynamicResource MaterialDesignFont}"
	ResizeMode="NoResize"
	WindowStyle="None"
	WindowState="Maximized"
	Title="MainWindow"
	Height="1080"
	Width="1920" xmlns:windows="clr-namespace:System.Windows;assembly=PresentationFramework">
	<Control.Background>
		<ImageBrush
			ImageSource="Images/background.jpg" />
	</Control.Background>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid
			Row="2"
			Column="1"
			ColumnSpan="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="auto" />
			</Grid.ColumnDefinitions>
			<Grid
				Column="0">
				<Panel.Background>
					<ImageBrush
						ImageSource="Images/typeQuestionFinish.png" />
				</Panel.Background>
				<TextBlock
					FontSize="80"
					FontWeight="Bold"
					Foreground="#FFFFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Text="20 ĐIỂM" />
			</Grid>
			<Grid
				Column="1">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<CheckBox
					Grid.Row="0"
					Background="#FFFFFFFF"
					materialDesign:CheckBoxAssist.CheckBoxSize="70" />
				<CheckBox
					Grid.Row="1"
					Background="#FFFFFFFF"
					materialDesign:CheckBoxAssist.CheckBoxSize="70" />
				<CheckBox
					Grid.Row="2"
					Background="#FFFFFFFF"
					materialDesign:CheckBoxAssist.CheckBoxSize="70" />
			</Grid>
		</Grid>
		<Grid
			Row="2"
			Column="4"
			ColumnSpan="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="auto" />
			</Grid.ColumnDefinitions>
			<Grid
				Column="0">
				<Panel.Background>
					<ImageBrush
						ImageSource="Images/typeQuestionFinish.png" />
				</Panel.Background>
				<TextBlock
					FontSize="80"
					FontWeight="Bold"
					Foreground="#FFFFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Text="30 ĐIỂM" />
			</Grid>
			<Grid
				Column="1">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<CheckBox
					Grid.Row="0"
					Background="#FFFFFFFF"
					materialDesign:CheckBoxAssist.CheckBoxSize="70" />
				<CheckBox
					Grid.Row="1"
					Background="#FFFFFFFF"
					materialDesign:CheckBoxAssist.CheckBoxSize="70" />
				<CheckBox
					Grid.Row="2"
					Background="#FFFFFFFF"
					materialDesign:CheckBoxAssist.CheckBoxSize="70" />
			</Grid>
		</Grid>
	</Grid>
</windows:Window>
