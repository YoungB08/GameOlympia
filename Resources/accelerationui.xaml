<controls:UserControl
	x:Class="Olympia_ThiSinh.AccelerationUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Olympia_ThiSinh" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	TextElement.FontWeight="Regular"
	TextElement.FontSize="13"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="Auto"
	FontFamily="{DynamicResource MaterialDesignFont}" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="205" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<TextBlock
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontSize="45"
				FontWeight="Bold"
				Foreground="#FFFFFFFF"
				Text="Phần thi: Tăng Tốc"
				Margin="30" />
		</Grid>
		<Border
			Grid.Row="1"
			BorderBrush="#FFFFFFFF"
			BorderThickness="2"
			CornerRadius="0 0 3 3 "
			Margin="5">
			<Border.Background>
				<SolidColorBrush
					Color="Black"
					Opacity="0.3" />
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="400" />
				</Grid.ColumnDefinitions>
				<GridSplitter
					Grid.Column="1"
					Width="5"
					HorizontalAlignment="Stretch"
					Background="#FFFFFFFF" />
				<Grid
					Column="0">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition
							Height="3.7*" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition
							Width="7*" />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Grid
						Margin="0 0 0 5"
						Row="0"
						Column="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="153*" />
							<ColumnDefinition
								Width="236*" />
						</Grid.ColumnDefinitions>
						<Panel.Background>
							<ImageBrush
								ImageSource="Images/backgroundv3.png"
								Stretch="Fill" />
						</Panel.Background>
						<TextBlock
							Name="txtQuestion"
							TextWrapping="Wrap"
							TextAlignment="Center"
							VerticalAlignment="Center"
							Margin="5,0,5,0"
							FontSize="30"
							Foreground="#FFFFFFFF"
							Grid.ColumnSpan="2" />
					</Grid>
					<Grid
						Row="2"
						Column="1">
						<Panel.Background>
							<ImageBrush
								ImageSource="Images/backgroundv2.png"
								Stretch="Fill" />
						</Panel.Background>
						<Image
							Name="ImageQuestion" />
						<MediaElement
							Name="VideoQuestion"
							LoadedBehavior="Manual"
							UnloadedBehavior="Stop" />
					</Grid>
				</Grid>
				<Grid
					Column="2">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<Grid
						Row="0">
						<Ellipse
							Fill="#FFFFA500"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Width="200"
							Height="200" />
						<TextBlock
							Name="txtCountDown"
							Foreground="#FF000000"
							FontSize="80"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Text="10" />
					</Grid>
					<Grid
						Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition
								Width="auto" />
						</Grid.ColumnDefinitions>
						<Border
							Grid.Column="0"
							Margin="0 5 5 10"
							VerticalAlignment="Bottom"
							BorderBrush="#FFFFFFFF"
							BorderThickness="2"
							CornerRadius="2">
							<TextBox
								Name="txtAnswer"
								Margin="1 0 0 0"
								CaretBrush="#FFFFFFFF"
								Foreground="#FFFFFFFF"
								FontSize="28" />
						</Border>
						<Button
							Name="btnSend"
							IsDefault="True"
							IsEnabled="False"
							materialDesign:RippleAssist.Feedback="#DD000000"
							Width="100"
							Height="50"
							Grid.Column="1"
							Margin="0,0,0,9"
							VerticalAlignment="Bottom"
							Background="#FFADFF2F"
							HorizontalAlignment="Right"
							Click="btnSend_Click">
							<TextBlock>Gửi (Enter)</TextBlock>
						</Button>
					</Grid>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</controls:UserControl>
