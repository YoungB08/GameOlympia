<controls:UserControl
	x:Class="Olympia_ThiSinh.SubQuestionUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Olympia_ThiSinh" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	TextElement.FontWeight="Regular"
	TextElement.FontSize="13"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="Auto"
	FontFamily="{DynamicResource MaterialDesignFont}" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="205" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<TextBlock
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontSize="45"
				Foreground="#FFFFFFFF"
				FontWeight="Bold"
				Text="Phần thi: Câu Hỏi Phụ"
				Margin="30" />
		</Grid>
		<Border
			Grid.Row="1"
			BorderBrush="#FFFFFFFF"
			BorderThickness="2"
			CornerRadius="0 0 3 3 "
			Margin="5">
			<Border.Background>
				<SolidColorBrush
					Color="Black"
					Opacity="0.3" />
			</Border.Background>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="350" />
				</Grid.ColumnDefinitions>
				<Grid
					Column="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition
							Width="auto" />
					</Grid.ColumnDefinitions>
					<Grid
						Column="0"
						Margin="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition
								Width="8*" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Grid
							Margin="0 0 0 5"
							Column="1">
							<Panel.Background>
								<ImageBrush
									ImageSource="Images/backgroundv2.png"
									Stretch="Fill" />
							</Panel.Background>
							<DockPanel
								HorizontalAlignment="Left"
								VerticalAlignment="Top">
								<TextBlock
									Margin="3"
									VerticalAlignment="Center"
									DockPanel.Dock="Left"
									Text="Câu hỏi:   "
									Foreground="#FFFF4500"
									FontSize="20" />
								<TextBlock
									Name="TxtQuestion"
									TextWrapping="Wrap"
									Foreground="#FFFFFFFF"
									FontSize="20"
									VerticalAlignment="Center"
									Margin="3" />
							</DockPanel>
						</Grid>
					</Grid>
				</Grid>
				<Grid
					Column="2">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<DockPanel
						Grid.Row="1"
						LastChildFill="False">
						<StackPanel
							DockPanel.Dock="Bottom">
							<Button
								Name="Claim"
								materialDesign:RippleAssist.IsDisabled="True"
								IsEnabled="False"
								materialDesign:RippleAssist.Feedback="#DD000000"
								Background="#FFADFF2F"
								materialDesign:ButtonAssist.CornerRadius="10"
								Style="{StaticResource MaterialDesignRaisedButton}"
								Height="100"
								Width="200"
								Margin="20"
								FontSize="30"
								Click="Claim_Click">
								<StackPanel>
									<TextBlock
										HorizontalAlignment="Center"
										VerticalAlignment="Center">Giành quyền</TextBlock>
								</StackPanel>
							</Button>
						</StackPanel>
					</DockPanel>
					<Viewbox
						Grid.Row="0">
						<Grid
							Margin="55">
							<Ellipse
								Height="150"
								Width="150"
								Fill="#FFDA70D6" />
							<TextBlock
								Name="txtCountDown"
								Foreground="#FFFFFFFF"
								Text="15"
								FontSize="70"
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
						</Grid>
					</Viewbox>
				</Grid>
				<GridSplitter
					Grid.Column="1"
					Width="5"
					HorizontalAlignment="Stretch"
					Background="#FFFFFFFF" />
			</Grid>
		</Border>
	</Grid>
</controls:UserControl>
