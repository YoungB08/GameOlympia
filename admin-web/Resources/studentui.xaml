<controls:UserControl
	x:Class="Olympia_ThiSinh.StudentUI" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Olympia_ThiSinh" xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
	<Grid>
		<Panel.Background>
			<ImageBrush
				ImageSource="Images/score.png" />
		</Panel.Background>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				Width="auto" />
		</Grid.ColumnDefinitions>
		<Grid
			Name="ColorScore"
			Opacity="0"
			Column="0"
			ColumnSpan="2">
			<Panel.Background>
				<ImageBrush
					ImageSource="Images/selectedScore.png" />
			</Panel.Background>
		</Grid>
		<Grid
			Name="GreenColorScore"
			Opacity="0"
			Column="0"
			ColumnSpan="2">
			<Panel.Background>
				<ImageBrush
					ImageSource="Images/selectedGreenScore.png" />
			</Panel.Background>
		</Grid>
		<TextBlock
			Name="txtName"
			Foreground="#FFFFFFFF"
			Tag=""
			Margin="5 0 0 0"
			Grid.Column="0"
			Text="Empty"
			FontSize="20"
			VerticalAlignment="Center"
			HorizontalAlignment="Left" />
		<TextBlock
			Name="txtScore"
			Grid.Column="1"
			Foreground="#FFFFFFFF"
			Text="0"
			FontSize="20"
			Margin="0 0 15 0"
			VerticalAlignment="Center"
			HorizontalAlignment="Right" />
	</Grid>
</controls:UserControl>
