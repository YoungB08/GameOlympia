<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= overlay ? 'Overlay' : 'Projector' %> - <%= room.room_code %></title>
  <link rel="stylesheet" href="/public/broadcast.css">
</head>
<body class="broadcast <%= overlay ? 'overlay' : '' %>">
  <div class="projector-stage">
    <div class="projector-bg" id="projectorBg"></div>
    <div class="top-line" style="position:absolute;left:5%;right:5%;top:5%;z-index:2">
      <div class="badge" id="contestTitle">Olympia</div>
      <div class="score-frame" id="roundName">SETUP</div>
    </div>
    <div class="projector-score-strip" id="projectorScores"></div>
    <div class="projector-question">
      <div id="projectorQuestion">Đang chờ câu hỏi...</div>
      <div class="timer-shell"><div class="timer-bar" id="timerBar"></div></div>
    </div>
    <div class="puzzle-grid" id="puzzleGrid">
      <% [1,2,3,4].forEach((tile) => { %><div class="puzzle-tile" data-tile="<%= tile %>"></div><% }) %>
    </div>
  </div>
  <script>window.ROOM_CODE = "<%= room.room_code %>";</script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/public/realtime-client.js"></script>
  <script>
    const $ = (id) => document.getElementById(id);
    window.renderRealtimeState = function (state) {
      $("contestTitle").textContent = state.contestTitle || "Olympia";
      $("roundName").textContent = String(state.round || "setup").toUpperCase();
      $("projectorQuestion").textContent = state.question?.visible ? (state.question.text || "") : "Đang chờ câu hỏi...";
      $("projectorScores").innerHTML = (state.candidates || []).slice(0, state.scoring?.candidateCount || 4).map((c) => (
        `<div class="projector-score-card"><div class="diamond-score"><span>${c.score}</span></div><div class="diamond-name">${c.display_name}</div></div>`
      )).join("");
      const media = state.question?.mediaUrl || state.puzzle?.imageUrl || "";
      $("projectorBg").style.backgroundImage = media ? `linear-gradient(rgba(1,4,9,.35), rgba(1,4,9,.35)), url("${media}")` : "";
      $("projectorBg").style.backgroundSize = "cover";
      $("projectorBg").style.filter = state.puzzle?.revealed?.every(Boolean) ? "blur(0)" : "blur(15px)";
      document.querySelectorAll(".puzzle-tile").forEach((tile, index) => {
        tile.classList.toggle("revealed", Boolean(state.puzzle?.revealed?.[index]));
      });
      const total = Number(state.timer?.seconds || 0);
      const remaining = Number(state.timer?.remaining || 0);
      const pct = total > 0 ? Math.max(0, Math.min(100, remaining / total * 100)) : 100;
      $("timerBar").style.width = `${pct}%`;
      $("timerBar").classList.toggle("warn", pct <= 50 && pct > 25);
      $("timerBar").classList.toggle("danger", pct <= 25);
    };
  </script>
</body>
</html>
